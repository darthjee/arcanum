{
  "name": "arcanum-cli",
  "version": "2.2.1",
  "description": "Command-line client for Arcanum, a collection of Claude Code skills: inspect and edit Arcanum's configuration tiers.",
  "homepage": "https://github.com/darthjee/arcanum/tree/main/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darthjee/arcanum.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/darthjee/arcanum/issues"
  },
  "type": "module",
  "bin": {
    "arcanum": "bin/arcanum"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "yarn build",
    "test": "c8 jasmine",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "c8": "12.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.8.1",
    "eslint-plugin-jsdoc": "63.3.3",
    "globals": "17.11.0",
    "jasmine": "7.0.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "c8": {
    "reporter": [
      "text",
      "lcov"
    ],
    "exclude": [
      "spec/**",
      "dist/**",
      "eslint.config.mjs"
    ],
    "lines": 50,
    "functions": 50,
    "branches": 50,
    "statements": 50,
    "check-coverage": false
  }
}

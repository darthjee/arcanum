#!/usr/bin/env node

// Centralized native CLI entrypoint for arcanum's migrated skill
// entrypoints — see docs/agents/architecture/script-engine.md.
//
// `arcanum/_lib/engine_dispatch.sh` invokes this file as plain argv:
// `core/bin/arcanum <command> <args...>`. This router takes the first
// argument as the command name, looks it up in the COMMANDS registry
// below, and dispatches to the matching module under `core/lib/`,
// passing the remaining arguments through. Real migrated entrypoints are
// wired into COMMANDS incrementally, one command at a time — starting
// with `resolve-and-fetch` (issue #193), alongside the
// `dispatch-fixture`/`dispatch-fixture-crash` proof commands from #192.

import path from 'node:path';
import { fileURLToPath, pathToFileURL } from 'node:url';
import DispatchFailure from '../lib/DispatchFailure.js';
import InvocationLog from '../lib/InvocationLog.js';

const libDir = path.join(path.dirname(fileURLToPath(import.meta.url)), '..', 'lib');
// Two levels up from core/bin, mirroring how engine_dispatch.sh itself
// resolves core/bin/arcanum's path in the other direction.
const configChainPath = path.join(
  path.dirname(fileURLToPath(import.meta.url)),
  '..',
  '..',
  'arcanum',
  '_lib',
  'config_chain.sh'
);

/**
 * Registry mapping each supported command name to the `core/lib/`
 * module and method that implements it. Keeping this table as the
 * single source of truth is what lets this router stay generic: adding
 * a migrated entrypoint only ever means adding one entry here.
 * @type {object}
 */
const COMMANDS = {
  'arcanum-split-issue-create-sub-issue-file': {
    module: 'ArcanumSplitIssueCreateSubIssueFile.js',
    method: 'run'
  },
  'arcanum-split-issue-finish': { module: 'ArcanumSplitIssueFinish.js', method: 'run' },
  'auto-fix-all-cleanup-artifacts': { module: 'AutoFixAllCleanupArtifacts.js', method: 'run' },
  'auto-fix-all-reply-comment': { module: 'AutoFixAllReplyComment.js', method: 'run' },
  'checkout-safe-branch': { module: 'SafeBranch.js', method: 'run' },
  'dispatch-fixture': { module: 'DispatchFixture.js', method: 'run', log: false },
  // dispatch-fixture-crash is deliberately left logged (entry.log
  // !== false, the default) — it exists specifically to prove that
  // InvocationLog#record runs and is awaited before the command's own
  // (crashing) module is invoked, so logging survives a crash. See
  // docs/agents/plans/244-add-logs-to-native-nodejs-calls/node.md.
  'dispatch-fixture-crash': { module: 'DispatchFixture.js', method: 'crash' },
  'github-issue-create': { module: 'GithubIssue.js', method: 'create' },
  'github-issue-info': { module: 'GithubIssue.js', method: 'info' },
  'issue-state': { module: 'IssueState.js', method: 'run' },
  'list-agents': { module: 'ListAgents.js', method: 'run' },
  'permission-grant': { module: 'PermissionGrant.js', method: 'run' },
  'resolve-and-fetch': { module: 'ResolveAndFetch.js', method: 'run' },
  'resolve-id-and-file': { module: 'ResolveIdAndFile.js', method: 'run' },
  'resolve-plan-paths': { module: 'ResolvePlanPaths.js', method: 'run' },
  'spawn-issue': { module: 'SpawnIssue.js', method: 'run' }
};

/**
 * Dispatch a single CLI invocation to its matching `core/lib/` module.
 * @param {string} command - the command name, e.g. `dispatch-fixture`.
 * @param {string[]} args - the command's own remaining arguments.
 * @returns {Promise<void>} resolves once the command has run.
 */
async function dispatch(command, args) {
  const entry = COMMANDS[command];

  if (!entry) {
    throw new Error(`unknown command '${command}'`);
  }

  if (entry.log !== false) {
    await new InvocationLog({ configChainPath }).record(command);
  }

  const modulePath = pathToFileURL(path.join(libDir, entry.module)).href;
  const { default: ModuleClass } = await import(modulePath);
  let output = new ModuleClass()[entry.method](...args);

  // Migrated entrypoints (e.g. resolve-and-fetch) are async — await
  // their result before deciding whether to print it. dispatch-fixture's
  // synchronous methods pass straight through unaffected.
  if (output && typeof output.then === 'function') {
    output = await output;
  }

  if (typeof output === 'string') {
    process.stdout.write(output);
  }
}

const [command, ...args] = process.argv.slice(2);

dispatch(command, args).catch((error) => {
  if (error instanceof DispatchFailure) {
    process.stdout.write(error.stdout);
    process.exitCode = error.exitCode ?? 1;
    return;
  }

  process.stderr.write(`arcanum: ${error.message}\n`);
  process.exitCode = 1;
});

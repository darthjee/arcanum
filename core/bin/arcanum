#!/usr/bin/env node

// Centralized native CLI entrypoint for arcanum's migrated skill
// entrypoints — see docs/agents/architecture/script-engine.md.
//
// `arcanum/_lib/engine_dispatch.sh` invokes this file as plain argv:
// `core/bin/arcanum <command> <args...>`. This entrypoint parses the
// first argument as the command name and delegates everything else to
// `core/lib/core/dispatcher.js`, which owns the command registry lookup
// (registry lives in `core/lib/core/commands.js`), invocation logging,
// and module resolution/invocation. All this entrypoint does is: parse
// argv, run the Dispatcher, print a string result, and enforce the
// error/exit-code contract.

import Dispatcher from '../lib/core/dispatcher.js';
import DispatchFailure from '../lib/utils/errors/DispatchFailure.js';

const [command, ...args] = process.argv.slice(2);

// Exit codes 125-127 are reserved for Docker itself: engine_dispatch.sh
// reads a `docker run` exit in that range as "Docker failed" and falls
// back to the host (see docs/agents/specs/docker/dispatch.md -> "Exit
// codes and streams"). A command must never surface one of them, so a
// DispatchFailure asking for 125, 126 or 127 exits 1 instead.
const DOCKER_RESERVED_EXIT_CODES = [125, 126, 127];

/**
 * @param {?number} exitCode - the exit code a DispatchFailure requested.
 * @returns {number} the process exit code to use (defaults to 1, and
 *   remaps the Docker-reserved 125-127 to 1).
 */
function failureExitCode(exitCode) {
  const code = exitCode ?? 1;

  return DOCKER_RESERVED_EXIT_CODES.includes(code) ? 1 : code;
}

new Dispatcher(command, args)
  .dispatch()
  .then((output) => {
    if (typeof output === 'string') {
      process.stdout.write(output);
    }
  })
  .catch((error) => {
    if (error instanceof DispatchFailure) {
      process.stdout.write(error.stdout);
      process.exitCode = failureExitCode(error.exitCode);
      return;
    }

    process.stderr.write(`arcanum: ${error.message}\n`);
    process.exitCode = 1;
  });

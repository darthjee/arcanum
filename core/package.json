{
  "name": "@arcanum/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Arcanum's native Node.js implementation of migrated skill entrypoint scripts. See docs/agents/architecture/script-engine.md.",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "arcanum": "./bin/arcanum"
  },
  "scripts": {
    "test": "c8 jasmine",
    "lint": "eslint .",
    "duplication": "jscpd --config .jscpd.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "c8": "^12.0.0",
    "eslint": "^10.8.1",
    "eslint-plugin-jsdoc": "^63.3.3",
    "globals": "^17.11.0",
    "jasmine": "^7.0.0",
    "jscpd": "^5.0.15"
  },
  "c8": {
    "reporter": [
      "text",
      "lcov"
    ],
    "exclude": [
      "spec/**",
      "eslint.config.mjs"
    ],
    "lines": 50,
    "functions": 50,
    "branches": 50,
    "statements": 50,
    "check-coverage": false
  }
}

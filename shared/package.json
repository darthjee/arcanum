{
  "name": "@arcanum/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Code shared by Arcanum's core/ and cli/: the config surface (config chain, repo config, key registry, lock, repo path).",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "c8 jasmine",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "c8": "12.0.0",
    "eslint": "10.8.1",
    "eslint-plugin-jsdoc": "63.3.3",
    "globals": "17.11.0",
    "jasmine": "7.0.0"
  },
  "c8": {
    "reporter": [
      "text",
      "lcov"
    ],
    "exclude": [
      "spec/**",
      "eslint.config.mjs"
    ],
    "lines": 50,
    "functions": 50,
    "branches": 50,
    "statements": 50,
    "check-coverage": true
  }
}
